{
  "manifest_version": 3,
  "name": "Bug Report Generator",
  "version": "1.2",
  "description": "自动抓取截图、接口日志和操作步骤，一键生成 Bug 报告",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "sidePanel",
    "debugger"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": { "default": "Ctrl+Shift+S" },
      "description": "开始/停止录制"
    },
    "capture-screenshot": {
      "suggested_key": { "default": "Ctrl+Shift+X" },
      "description": "截取当前页面"
    },
    "open-panel": {
      "suggested_key": { "default": "Ctrl+Shift+U" },
      "description": "打开扩展面板"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["settings.html", "viewer.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
